# Copy this file to .env and fill in the values before running the app.
# IMPORTANT: Do not commit the actual .env file to Git.

# Password for the admin login page (/admin/login)
ADMIN_PASSWORD=change_this_password

# Secret key used to sign session cookies
SESSION_SECRET=change_this_to_a_long_random_string

# Optional: custom application port used by the Node server
# PORT=4321
